      "Type": "AWS::StepFunctions::StateMachine",
      "Properties": {
        "DefinitionString": {
          "Fn::Sub": [
            "{\n  \"StartAt\": \"distributor\",\n  \"States\": {\n    \"distributor\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"${55d26fd665f88c35bf0401c8ae34b292}\",\n      \"Next\": \"forEachField\"\n    },\n    \"forEachField\": {\n      \"Type\": \"Map\",\n      \"ItemsPath\": \"$.fields\",\n      \"MaxConcurrency\": 2,\n      \"Iterator\": {\n        \"StartAt\": \"hello\",\n        \"States\": {\n          \"hello\": {\n            \"Type\": \"Task\",\n            \"Resource\": \"${da910a91800570dbe89d3c96c8f2a400}\",\n            \"Next\": \"forEachDate\"\n          },\n          \"forEachDate\": {\n            \"Type\": \"Map\",\n            \"ItemsPath\": \"$.items\",\n            \"MaxConcurrency\": 20,\n            \"Iterator\": {\n              \"StartAt\": \"processor\",\n              \"States\": {\n                \"processor\": {\n                  \"Type\": \"Task\",\n                  \"Resource\": \"${76da4b5355a8a72322bd04f5466edb80}\",\n                  \"End\": true\n                }\n              }\n            },\n            \"End\": true\n          }\n        }\n      },\n      \"End\": true\n    }\n  }\n}",
            {
              "55d26fd665f88c35bf0401c8ae34b292": {
                "Fn::GetAtt": [
                  "DistributorLambdaFunction",
                  "Arn"
                ]
              },
              "da910a91800570dbe89d3c96c8f2a400": {
                "Fn::GetAtt": [
                  "HelloLambdaFunction",
                  "Arn"
                ]
              },
              "76da4b5355a8a72322bd04f5466edb80": {
                "Fn::GetAtt": [
                  "ProcessorLambdaFunction",
                  "Arn"
                ]
              }
            }
          ]
        },
        "RoleArn": {
          "Fn::GetAtt": [
            "NdviWorkflowRole",
            "Arn"
          ]
        },
        "StateMachineName": "ndviWorkflow"
      },
      "DependsOn": [
