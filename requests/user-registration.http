### CDSE-tunnusten vaihto (väärät tunnukset)
PUT {{baseUrl}}/api/user/cdse-credentials
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "clientId": "vaara-id",
  "clientSecret": "vaara-secret"
}

### Heikko salasana
# Odotettu: 400 ja errors-lista
POST {{baseUrl}}/api/user/register
Content-Type: application/json

{
  "email": "heikko+test@example.com",
  "password": "heikko",
  "username": "ab",
  "clientId": "{{$dotenv CDSE_CLIENT_ID}}",
  "clientSecret": "{{$dotenv CDSE_CLIENT_SECRET}}"
}

### Sama client id toiselle käyttäjälle
# Odotettu: 409 CDSE_ALREADY_IN_USE
POST {{baseUrl}}/api/user/register
Content-Type: application/json

{
  "email": "toinen+test@example.com",
  "password": "{{password}}",
  "username": "toinen-tester",
  "clientId": "{{$dotenv CDSE_CLIENT_ID}}",
  "clientSecret": "{{$dotenv CDSE_CLIENT_SECRET}}"
}


### Unohtunut salasana (oikea, vahvistettu sähköposti)
# Odotettu: 200 {"message":"If the email exists, a reset link has been sent."}
# Sähköposti: viesti "Salasanan vaihto" ja linkki ...?token=<64 merkkiä>
POST {{baseUrl}}/api/user/forgot-password
Content-Type: application/json

{
  "email": "{{email}}",
  "lang": "en"
}

### Salasanan vaihto tokenilla, token on viestin linkissä
# Odotettu: 200 {"ok":true}

PATCH {{baseUrl}}/api/user/reset-password
Content-Type: application/json

{
  "token": "d4ffe6085adee9f9c072f0a1834c48c4dc0531a050acaefb951eb90f7eed9dd7",
  "password": "Rytkynranta#2026"
}


### Unohtunut salasana (ei vahvistettu sähköposti)
# EI tätä: Odotettu: 200 {"message":"If the email exists, a reset link has been sent."}
# EI tätä: Sähköposti: viesti "Salasanan vaihto" ja linkki ...?token=<64 merkkiä>
POST {{baseUrl}}/api/user/forgot-password
Content-Type: application/json

{
  "email": "test@example.com",
  "lang": "en"
}